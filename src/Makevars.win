CXX_STD = CXX17

CXXFLAGS+=-Wno-ignored-attributes
CXX11FLAGS+=-Wno-ignored-attributes
CXX14FLAGS+=-Wno-ignored-attributes

PKG_CXXFLAGS = $(CXXFLAGS) -std=c++17
PKG_CPPFLAGS = -DARMA_64BIT_WORD=1
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
PKG_CXXFLAGS=-Iglmnetpp/include -Iglmnetpp/src -Iglmnetpp/test -DEIGEN_PERMANENTLY_DISABLE_STUPID_WARNINGS